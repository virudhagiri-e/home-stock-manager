  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.75.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
